{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-sessions@1.0.0"
  ],
  "enabled_providers": [
    "openai",
    "anthropic",
    "gemini",
    "deepseek"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "{env:DEEPSEEK_BASE_URL}"
      }
    }
  },
  "model": "{env:DEFAULT_MODEL_PROVIDER}/{env:DEFAULT_MAIN_MODEL}",
  "small_model": "{env:DEFAULT_MODEL_PROVIDER}/{env:DEFAULT_SMALL_MODEL}",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "{env:DEFAULT_MODEL_PROVIDER}/{env:DEFAULT_MAIN_MODEL}",
      "permission": {
        "session": "allow",
        "read": "allow"
      }
    },
    "build": {
      "model": "{env:DEFAULT_MODEL_PROVIDER}/{env:DEFAULT_BUILD_MODEL}",
      "permission": {
        "session": "allow"
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "session": "deny"
  }
}
