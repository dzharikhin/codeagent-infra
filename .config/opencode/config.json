{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "plugin": [
    "opencode-sessions@1.0.0"
  ],
  "enabled_providers": [
    "openai",
    "anthropic",
    "deepseek"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    },
    "openai": {
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "{env:DEEPSEEK_BASE_URL}"
      }
    }
  },
  "model": "{env:MAIN_MODEL}",
  "small_model": "{env:SMALL_MODEL}",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "{env:MAIN_MODEL}",
      "permission": {
        "session": "allow",
        "read": "allow"
      }
    },
    "build": {
      "model": "{env:BUILD_MODEL}",
      "permission": {
        "session": "allow"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "external_directory": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "webfetch": "allow",
    "session": "deny"
  }
}
