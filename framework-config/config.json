{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "plugin": [
    "opencode-sessions@1.0.0",
    "@spoons-and-mirrors/subtask2@latest",
    "@mohak34/opencode-notifier@latest"
  ],
  "model": "{env:OCF_MAIN_MODEL}",
  "small_model": "{env:OCF_SMALL_MODEL}",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "{env:OCF_MAIN_MODEL}",
      "permission": {
        "session": "allow",
        "read": "allow"
      }
    },
    "build": {
      "model": "{env:OCF_BUILD_MODEL}",
      "permission": {
        "session": "allow"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "external_directory": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "webfetch": "allow",
    "session": "deny"
  }
}
