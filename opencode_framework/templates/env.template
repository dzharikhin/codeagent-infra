REMOTE_USER=root
XDG_CONFIG_HOME=/home/${REMOTE_USER:-root}/.config
XDG_DATA_HOME=/home/${REMOTE_USER:-root}/.local/share
XDG_STATE_HOME=/home/${REMOTE_USER:-root}/.local/state
XDG_CACHE_HOME=/home/${REMOTE_USER:-root}/.cache
OCF_LOCAL_FRAMEWORK_PATH={{OCF_LOCAL_FRAMEWORK_PATH}}
OCF_REMOTE_FRAMEWORK_CONFIG_PATH=/opt/ocframework/config
# Host dotfiles mirrored read-only into the container home (empty value =
# file absent on the host at generation time; the compose mount then falls
# back to /dev/null). Refresh via 'ocframework reconfigure' or init --force.
OCF_NPMRC_PATH={{OCF_NPMRC_PATH}}
# Host Maven settings, mirrored read-only when the Maven feature is on.
OCF_M2_SETTINGS_PATH={{OCF_M2_SETTINGS_PATH}}{{GRADLE_ENV}}
# Host git config, mirrored read-only (always on; empty value = file
# absent on the host, the compose mount then falls back to /dev/null).
OCF_GITCONFIG_PATH={{OCF_GITCONFIG_PATH}}
# Host SSH directory (keys, config, known_hosts), mirrored read-only
# when the ssh feature is on. Empty value = feature off or ~/.ssh
# absent on the host; the compose mount line is omitted entirely (no
# /dev/null fallback — a char device at ~/.ssh would break ssh).
OCF_SSH_DIR_PATH={{OCF_SSH_DIR_PATH}}
{{AGENT_ENV_TEMPLATE}}
# Agent version pin (devcontainer feature version / Dockerfile build arg)
OCF_AGENT_VERSION=latest

# Model stack. Can also be set in user global config
# if you use the same models across projects.
OCF_MAIN_MODEL=anthropic/claude-opus-4-8
OCF_BUILD_MODEL=anthropic/claude-sonnet-4-6
OCF_SMALL_MODEL=anthropic/claude-haiku-4-6
OCF_PLAN_MAX_BEFORE_RESPONSE_STEPS=100
OCF_BUILD_MAX_BEFORE_RESPONSE_STEPS=100