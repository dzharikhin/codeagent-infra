{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "OpenCode - ${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "runtime_data/Dockerfile",
    "context": "."
  },
  "initializeCommand": "{{DOCKERFILE_INITIALIZER}}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installPackages": "ripgrep"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/opencode:1.1.1": {
      "version": "${localEnv:OPENCODE_VERSION:latest}"
    }
  },
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "containerUser": "${localEnv:REMOTE_USER:root}",
  "remoteUser": "${localEnv:REMOTE_USER:root}"
}
